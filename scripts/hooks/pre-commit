#!/usr/bin/env bash
# Git pre-commit hook running the fast check gate (scripts/check.sh).
#
# Install once per clone:   git config core.hooksPath scripts/hooks
# Skip for one commit:      git commit --no-verify   (or SKIP_CHECKS=1)
#
# Note: the checks run against the working tree, not only the staged changes.
set -euo pipefail
if [ "${SKIP_CHECKS:-0}" = "1" ]; then
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
exec scripts/check.sh
